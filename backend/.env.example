# Chép file này thành .env.local rồi chỉnh nếu cần.
# TẤT CẢ đều là tuỳ chọn — công cụ chạy được mà không cần khai báo gì.
#
# .env.local KHÔNG được commit (xem .gitignore). File .env.example này thì có, và nó là
# tài liệu duy nhất mô tả các biến môi trường — thêm biến mới thì nhớ thêm vào đây.

# ===========================================================================
# NGUỒN QUẢNG CÁO
# Mỗi nguồn tự đọc biến của mình trong lib/ads/platforms/<tên>.py
# ===========================================================================

# --- Facebook ---
# Ads Library đọc được ẩn danh nên cookie là tuỳ chọn. Dùng cookie của một tài khoản phụ sẽ
# làm kết quả ổn định hơn khi nhiều người cùng search một lúc.
# Lấy ở DevTools > Application > Cookies trên facebook.com (cần c_user và xs).
# FB_COOKIE="c_user=100000000000000; xs=00%3Aabcdef..."

# Khoảng cách tối thiểu giữa hai request. Facebook chịu được gọi liên tiếp.
FB_MIN_INTERVAL_MS=1500
# Phiên trình duyệt đã làm nóng được dùng lại trong bao lâu.
FB_SESSION_TTL_MS=600000

# --- TikTok ---
# ĐÂY LÀ BIẾN QUAN TRỌNG NHẤT CỦA NGUỒN TIKTOK.
#
# Không khai: Creative Center trả về 0 kết quả cho MỌI truy vấn từ khoá — kèm mã thành công,
# nên trông y như "sản phẩm không có nhu cầu". Công cụ khi đó tự chuyển sang duyệt bảng xếp
# hạng Top Ads và luôn kèm thông báo, nhưng kết quả KHÔNG liên quan tới từ khoá bạn gõ.
# Khai: search theo từ khoá chạy thật, và cờ "search được theo từ khoá" trên giao diện bật lên.
#
# Lấy ở DevTools > Application > Cookies trên ads.tiktok.com sau khi đăng nhập (cần sessionid).
# DÙNG TÀI KHOẢN PHỤ — cookie business dùng để gọi API tự động có rủi ro bị khoá.
# TIKTOK_COOKIE="sessionid=abc123...; sid_tt=abc123..."

# TikTok trả 40100 "too many requests" sau khoảng năm lần gọi nhanh. Tăng giá trị này nếu
# gặp lỗi đó.
TIKTOK_MIN_INTERVAL_MS=9000
# Chữ ký nhặt được đo thấy còn hiệu lực ít nhất ~3,5 phút; giữ an toàn dưới mức đó.
TIKTOK_SESSION_TTL_MS=150000

# --- YouTube (API chính thức, miễn phí) ---
# YouTube Data API v3: nguồn VIDEO trả URL thật, free 10.000 quota/ngày (~100 lần search).
# Không khai thì nguồn YouTube tắt (keyword_search=false), không ảnh hưởng nguồn khác.
# Lấy free: console.cloud.google.com → tạo project → APIs & Services → Library →
# bật "YouTube Data API v3" → Credentials → Create Credentials → API Key.
# YOUTUBE_API_KEY=AIzaSy...

# --- Etsy (API chính thức, miễn phí) ---
# Etsy Open API v3 cần CẢ keystring VÀ shared secret — header là `x-api-key: keystring:shared_secret`.
# Chỉ keystring → 403 "Shared secret is required". Không khai 2 biến này thì nguồn Etsy tắt
# (keyword_search=false), không ảnh hưởng nguồn khác.
# Lấy ở https://www.etsy.com/developers/your-apps (Keystring + Shared Secret của Personal App).
# ETSY_KEYSTRING=xxxxxxxxxxxxxxxxxxxxxxxx
# ETSY_SHARED_SECRET=xxxxxxxxxx

# --- Shopee / TikTok Shop: KHÔNG có biến nào ---
# Hai nguồn này là `client_fetch` — server chỉ dựng lệnh, còn extension trong trình duyệt bạn
# mới thật sự gọi, bằng chính phiên đăng nhập của bạn. Không có khoá nào để khai ở đây, và đó
# là chủ đích: cookie không bao giờ rời trình duyệt. Xem `extension/README.md`.

# --- Rút từ khoá từ tiêu đề sản phẩm (lib/ads/keyword_extract.py) ---
# Dùng CHUNG `GEMINI_API_KEY` và `GEMINI_MODEL` khai ở mục Từ khoá bên dưới — một khoá cho cả
# hai việc, không cần khai hai lần. Không khai thì rơi về heuristic (lấy vài từ đầu tiêu đề):
# luồng vẫn chạy, từ khoá kém chính xác hơn.

# ===========================================================================
# MỤC TỪ KHOÁ — GOOGLE TRENDS (lib/keywords/trends.py)
# ===========================================================================

# Khoảng cách tối thiểu giữa hai lần tải trang /explore.
#
# Trends là nguồn dễ bị chặn nhất trong hệ thống: mỗi lần tải trang xin bốn widget một lúc,
# và `relatedsearches` chạm trần sớm nhất. Giá trị này TỪNG BẰNG 0 và đó là lý do lỗi 429
# xuất hiện "lúc được lúc không". Hạ xuống nếu bạn chấp nhận rủi ro, tăng lên nếu vẫn gặp 429.
TRENDS_MIN_INTERVAL_MS=20000

# ===========================================================================
# MỤC TỪ KHOÁ — TIKTOK (lib/keywords/providers/tiktok.py)
# ===========================================================================

# Thị trường mà MÁY CHỦ NÀY đi ra Internet.
#
# Endpoint gợi ý của TikTok không nhận tham số vùng — nó trả kết quả theo IP người gọi. Đã đo
# và không ép được bằng bất cứ cách nào: tham số region, Accept-Language, cookie
# store-country-code, cookie định tuyến tt-target-idc, hay X-Forwarded-For.
#
# Vì vậy TikTok chỉ khai báo phục vụ đúng MỘT thị trường, và đây là chỗ khai. Đặt sai thì
# bảng vẫn hiện đầy đủ nhưng là từ khoá của nước khác — đo 2026-08-06: chọn Đài Loan nhận về
# 6/8 gợi ý tiếng Nhật, chọn Brazil nhận về 7/8 gợi ý tiếng Tây Ban Nha.
#
# Chỉ đổi khi bạn chuyển server sang nước khác (hoặc chạy qua VPN cố định của nước đó).
TIKTOK_HOME_MARKET=VN

# ===========================================================================
# MỤC TỪ KHOÁ — DỊCH NGHĨA (lib/keywords/gloss.py)
# ===========================================================================

# Dịch danh sách từ khoá nước ngoài về tiếng Việt để ĐỌC, hiện ngay dưới mỗi dòng trong bảng.
# Chỉ chạy khi thị trường không nói tiếng Việt; chọn VN thì không gọi lượt nào.
#
# Thiếu khoá KHÔNG làm hỏng gì: bảng từ khoá vẫn đầy đủ, chỉ là không có dòng nghĩa và có một
# ghi chú dưới bảng nói cần đặt biến này.
#
# Lấy khoá miễn phí ở https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# Model dùng để dịch. Đổi ở đây nếu Google đổi tên model hoặc cần bản mạnh hơn.
#
# Nâng lên bản mạnh hơn thường KHÔNG đáng — đo 2026-08-12, `gemini-3.6-flash` dịch sai đúng
# những cụm mà flash-lite sai (đều là tên chợ đầu mối, không model nào biết chắc) mà mất 16,3s
# thay vì 3,4s. Sai kiểu đó chữa bằng `MARKET_JARGON` trong lib/keywords/gloss.py.
GEMINI_MODEL=gemini-3.5-flash-lite

# ===========================================================================
# HẠ TẦNG CHUNG (lib/core/config.py)
# ===========================================================================

# Cache dùng chung cả team — đây là lý do chính chỉ chạy một server thay vì mỗi người một bản.
CACHE_TTL_MS=900000
CACHE_MAX_ENTRIES=300

# Thời gian tối đa chờ trình duyệt làm nóng trước khi coi nguồn đó là đang hỏng.
WARMUP_TIMEOUT_MS=75000

# Đặt false để xem trình duyệt chạy thật, phục vụ debug.
HEADLESS=true

# ===========================================================================
# PROXY CHO TIKTOK
# ===========================================================================
# CHỈ TikTok cần proxy, và chỉ TikTok được đi qua nó.
#
# Các nguồn khác không cần: Shopee chạy một tên miền riêng cho mỗi nước, Amazon và Taobao
# nhận tham số vùng. TikTok là nguồn duy nhất chọn thị trường theo IP người gọi và không nghe
# bất cứ thứ gì ta tự khai — xem phần đo trong lib/keywords/providers/tiktok.py.
#
# ĐỪNG đặt proxy ở tầng chung (biến HTTP_PROXY/HTTPS_PROXY của hệ điều hành). Làm vậy sẽ kéo
# theo cả Playwright và các phiên Google đã đăng nhập: một phiên Google đột nhiên đi ra từ IP
# nước khác là tín hiệu chiếm tài khoản kinh điển, và Google sẽ bắt xác minh lại cả pool.
#
# Đo 2026-08-14: IP DATACENTER là đủ, TikTok không đòi IP dân cư. Một proxy datacenter rẻ
# (~$1-3/IP/tháng) hoặc một VPS nhỏ chạy tinyproxy ở mỗi nước đều chạy được.
#
# Mỗi nước một dòng. Không khai dòng nào thì TikTok chạy y như cũ: đi thẳng, phục vụ đúng
# TIKTOK_HOME_MARKET.
#
# TIKTOK_PROXY_US=http://user:pass@host:port
# TIKTOK_PROXY_GB=http://user:pass@host:port
#
# Nhiều proxy cho cùng một nước thì thêm hậu tố _2, _3… Chúng được xoay vòng để 25 lượt gọi
# của một lần tìm không dồn hết vào một IP, và cái nào hỏng thì tự sang cái kế tiếp:
#
# TIKTOK_PROXY_GB_2=http://user:pass@host:port
# TIKTOK_PROXY_GB_3=http://user:pass@host:port
#
# TRƯỚC KHI KHAI, PHẢI KIỂM PROXY THẬT SỰ Ở NƯỚC ĐÓ:
#
#     python -m scripts.probe.proxy_audit "../Webshare 10 proxies.txt"
#
# Script so cả IP đi ra lẫn kết quả TikTok của từng proxy. Một proxy bán dưới nhãn "Thái Lan"
# nhưng đặt ở Việt Nam sẽ KHÔNG báo lỗi — nó trả về dữ liệu Việt Nam, rồi dữ liệu đó được xếp
# hạng và dán nhãn Thái Lan y như thật.
#
# Đừng tin cột "Country" của nhà cung cấp, mà cũng đừng tin một dịch vụ định vị IP duy nhất:
# đo 2026-08-14 thì ipinfo.io và ip-api.com BẤT ĐỒNG về cùng một IP (một bên nói Bồ Đào Nha,
# bên kia nói Ba Lan). Bằng chứng đáng tin nhất là chính kết quả TikTok: các proxy cùng một
# nước trả về danh sách GIỐNG HỆT nhau, và khác hẳn nước bên cạnh.

# Thị trường mà máy chủ đi ra khi không qua proxy.
TIKTOK_HOME_MARKET=VN


# ===========================================================================
# TÀI KHOẢN NGƯỜI DÙNG + PHÂN TÍCH — SUPABASE (lib/core/db.py)
# ===========================================================================
# KHÔNG khai 3 biến này → login/admin/analytics TẮT hết. Trang /login vẫn hoạt động ở chế độ
# chỉ-localStorage cũ (ai gõ username nào cũng vào được). Khai đủ → auth thật + admin panel bật.
#
# SET UP LẦN ĐẦU:
#   1. supabase.com → New project (region Singapore cho gần VN).
#   2. Settings → API → copy Project URL + service_role key (KHÔNG phải anon key).
#   3. SQL Editor → paste schema ở docs/supabase-schema.sql → Run.
#   4. Sinh JWT_SECRET random 32+ ký tự: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
#
# SUPABASE_URL=https://xxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# JWT_SECRET=chuỗi_random_32_ký_tự_trở_lên
#
# Thời gian sống của JWT — sau khoảng này user phải đăng nhập lại. 7 ngày là hợp cho tool nội bộ.
JWT_TTL_HOURS=168

# ═══════════════════════════════════════════════════════════════════════════════
# Trend Signal Hub (mục cuối trong sidebar) — `backend/hub/`
# ═══════════════════════════════════════════════════════════════════════════════
#
# Mục này chạy được NGAY mà không cần khai gì: dữ liệu nằm sẵn trong
# `backend/hub/data/snapshot/dataset.zip` (~9.8MB, 33.509 listing) và tự bung vào
# `backend/hub_data.db` ở lần khởi động đầu tiên. Các biến dưới đây chỉ mở thêm tính năng.

# Trợ lý AI trong Hub — ô "Bạn muốn nghiên cứu gì?" (One-shot AI) và phần tổng hợp insight.
#
# MẶC ĐỊNH DÙNG GEMINI, qua chính `GEMINI_API_KEY` khai ở trên — không phải khai thêm gì.
# Gemini có endpoint OpenAI-compatible nên `hub/llm.py` gọi nó y như mọi gateway khác.
# Đo 2026-08-25: /api/hub/oneshot trả lời trong ~7s, `llm_enabled` = true.
#
# Không có khoá nào -> Hub chạy heuristic: vẫn ra số, chỉ thiếu phần AI diễn giải, và
# `answered_by` trong phản hồi ghi "heuristic" chứ không giả vờ là AI.
#
# Model tiering để tối ưu chi phí. Mặc định:
#   MODEL_CHEAP=gemini-3.5-flash-lite    việc nhẹ, số lượng lớn
#   MODEL_SMART=gemini-3.5-flash         tổng hợp insight
# Đo 2026-08-25 trên khoá đang dùng: gemini-2.5-flash và gemini-2.0-flash đã bị Google gỡ
# (404 "no longer available"), gemini-pro-latest trả 429 hết quota. Đừng khai bừa tên model.
# MODEL_CHEAP=
# MODEL_SMART=

# Muốn đổi sang nhà cung cấp khác (BytePlus Ark/DeepSeek, OpenAI, Qwen, GLM...) thì khai ba
# biến này — khai tường minh thì THẮNG khoá Gemini ở trên. Phải khai cả MODEL_* cho khớp.
# Dùng tên LLM_* chứ KHÔNG dùng ANTHROPIC_*: Claude Code đặt sẵn biến ANTHROPIC_* trên máy
# và nó sẽ đè lên giá trị ở đây.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_AUTH_TOKEN=

# Cào Etsy qua API chính thức (mục Crawler của Hub). Thiếu thì phần cào Etsy nằm im,
# dữ liệu có sẵn trong snapshot vẫn đọc bình thường.
# ETSY_KEYSTRING=
# ETSY_SHARED_SECRET=

# Lịch cào đêm của Hub (Etsy/Amazon/Google Trends lúc 02:00–04:00 giờ máy). MẶC ĐỊNH TẮT.
# Dự án gốc bật sẵn, ở đây thì không: nó khiến một backend mở lên để tra sản phẩm tự đi lấy
# dữ liệu ngoài internet hằng đêm mà không ai nhìn thấy. Bật có ý thức bằng:
# HUB_SCHEDULER=1

# Đường tới SQLite của Hub. Mặc định `backend/hub_data.db`.
# HUB_DB_PATH=
