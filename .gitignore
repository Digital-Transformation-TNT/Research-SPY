# ---------------------------------------------------------------------------
# Phụ thuộc & kết quả build — luôn dựng lại được từ source, không bao giờ commit
# ---------------------------------------------------------------------------
node_modules/
.next/
# Thư mục build phụ do `NEXT_DIST_DIR` sinh ra — xem `frontend/next.config.mjs`. Dùng khi cần
# chạy song song một server thứ hai hoặc một lượt build mà không xoá chunk của server đang chạy.
.next-*/
out/
build/
next-env.d.ts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Python tự sinh. `.venv/` liệt kê ở đây cho chắc, chứ dự án chạy thẳng trên Python của máy.
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Bí mật — .env.example mới là file được commit, .env.local là của riêng mỗi máy
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# Trạng thái phiên đã đăng nhập do `scripts/auth/*` ghi ra. Tương đương một mật khẩu đang
# mở — ai có file này là đăng nhập được vào tài khoản đó.
backend/.auth/

# Danh sách proxy tải từ nhà cung cấp. Mỗi dòng có dạng ip:port:user:pass, tức là mật khẩu
# nằm thẳng trong file — commit lên là người khác dùng hết băng thông đã trả tiền của bạn.
# Chỗ đúng của chúng là `TIKTOK_PROXY_*` trong `.env.local`.
*proxies*.txt
*proxy*.txt

# Kho cache ghi xuống đĩa (`lib/core/store.py`). Dựng lại được bằng cách đi lấy lại
# dữ liệu, nên không thuộc về repo — nhưng lấy lại thì tốn thật, xem docstring ở đó.
backend/.cache/

# ---------------------------------------------------------------------------
# Kho lưu các script thăm dò một lần và dữ liệu dump.
# Giữ lại trên máy để tra khi một nền tảng đổi cấu trúc, nhưng không thuộc về repo:
# chúng là ghi chép nghiên cứu, không phải phần mềm đang chạy. Kết luận rút ra từ
# chúng đã được ghi thành comment ngay trong file của từng nguồn.
# ---------------------------------------------------------------------------
_archive/
.probe/

# ---------------------------------------------------------------------------
# Sản phẩm phụ khi chạy
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
screenshots/
playwright-report/
test-results/
coverage/

# ---------------------------------------------------------------------------
# Rác của hệ điều hành và IDE
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Kho tạm dạng pickle do các script dò ghi ra (`backend/_hits.pkl`). Dựng lại được, và một
# tệp nhị phân trong git thì mỗi lần đổi là một khối rác mới không diff được.
*.pkl

# SQLite của mục Trend Signal Hub (~80MB). Không commit: dựng lại được bằng cách bung
# `backend/hub/data/snapshot/dataset.zip` (~9.8MB, CÓ trong repo) — `hub.main.init_hub()` tự
# làm việc đó khi thấy DB rỗng. Một file nhị phân 80MB đổi mỗi đêm thì git không diff nổi.
backend/hub_data.db
backend/hub_data.db-journal
backend/hub_data.db-wal

# Model CLIP cho khớp ảnh (`backend/models/clip-vision.onnx`, ~350MB). Tải lúc chạy, không
# commit — git không phải nơi chứa trọng số model, và thiếu nó thì luồng tự rơi về pHash.
backend/models/

# Binary nssm — vps-setup.ps1 tự tải, không commit
deploy/nssm.exe
