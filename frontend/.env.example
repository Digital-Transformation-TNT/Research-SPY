# Chép thành .env.local nếu cần đổi. Chạy được mà không khai báo gì.
#
# Địa chỉ backend FastAPI. Next dùng nó cho hai việc: chuyển tiếp /api/* (xem
# next.config.mjs) và đọc danh sách nguồn trong server component (xem lib/api.ts).
# Chỉ đọc phía server — không có tiền tố NEXT_PUBLIC_ nên không lộ ra trình duyệt.
#
# Đổi giá trị này khi backend chạy ở máy khác hoặc cổng khác:
# BACKEND_URL=http://127.0.0.1:8000
